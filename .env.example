# MediaMTX Webcam Streaming - Environment Configuration
# Copy this file to .env and adjust values for your setup

# === CONTAINER & HOST NETWORKING ===
# Container IP/hostname (set by LXC, accessible on network)
CONTAINER_HOST=webcam-stream
CONTAINER_DOMAIN=stream.raumdock.org

# === USB CAMERA CONFIGURATION ===
# V4L2 device path - typically /dev/video0 for first camera
# Run 'v4l2-ctl --list-devices' in container to find yours
CAMERA_SOURCE=/dev/video0

# Camera resolution (supported by your camera)
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080

# Camera framerate
CAMERA_FPS=30

# Camera pixel format (MJPEG, YUYV, etc. - check with v4l2-ctl)
CAMERA_FORMAT=MJPEG

# === MEDIAMTX PORTS ===
# WebRTC streaming (peer-to-peer, low latency)
WEBRTC_PORT=8555

# HTTP API & Dashboard
HTTP_PORT=8888

# RTMP ingest (if you want to push streams to this container)
RTMP_PORT=1935

# RTSP protocol (internal, usually don't expose)
RTSP_PORT=8322

# HLS streaming fallback
HLS_PORT=8889

# === STREAMING PARAMETERS ===
# Video codec: h264, h265, vp8, vp9
VIDEO_CODEC=h264

# Video bitrate (kbps) - adjust for your network/quality tradeoff
# 25000 = ~25 Mbps (low-latency 1080p@30fps on fast LAN)
VIDEO_BITRATE=25000

# Audio enabled (true/false) - requires audio input device
AUDIO_ENABLED=false

# === MEDIAMTX CORE SETTINGS ===
# Enable debug logging
DEBUG=false

# Maximum concurrent connections per stream
MAX_CLIENTS=5

# Connection timeout (seconds)
TIMEOUT=30

# === DOCKER COMPOSE ===
# Docker image versions
MEDIAMTX_VERSION=1
ALPINE_VERSION=3.19

# Container restart policy: no, always, on-failure, unless-stopped
RESTART_POLICY=unless-stopped

# Resource limits
MEMORY_LIMIT=1024m
CPUS_LIMIT=4

# === STORAGE & RECORDINGS (Optional) ===
# Enable HLS recording/archiving
RECORD_HLS=false

# Recording directory (mounted volume)
RECORD_PATH=/recordings

# Recording format retention (hours)
RECORD_RETENTION=24

# === AUTHENTICATION (Optional) ===
# Enable basic auth for web interface
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme123

# === TLS/SSL (For secure access) ===
# Self-signed cert path (if using HTTPS)
TLS_ENABLED=false
TLS_CERT_PATH=/etc/mediamtx/cert.crt
TLS_KEY_PATH=/etc/mediamtx/key.key

# === PROXMOX HOST INFO ===
# Keep for reference - your Proxmox setup details
# Host: proxmox.raumdock.org
# LXC ID: 104
# USB Device: /dev/bus/usb/002/003 (example - find yours with lsusb)

# === CUSTOM STREAM PATHS ===
# Primary camera stream name
STREAM_NAME=webcam

# Additional streams (comma-separated if multiple cameras)
# ADDITIONAL_STREAMS=camera2,camera3
ADDITIONAL_STREAMS=

# === LOGGING ===
# Log level: silent, error, warn, info, debug
LOG_LEVEL=info

# Log output
LOG_FILE=/var/log/mediamtx/streaming.log
